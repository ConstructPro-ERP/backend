DATABASE_URL=postgresql://username:password@host/database?sslmode=require
DIRECT_URL_TEST=postgresql://username:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
PORT=3000

# This key decides which service to run when running server.ts. 
DEPLOY_APP=api-gateway

API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=3333
USER_SERVICE_PORT=3334
QUOTATION_SERVICE_PORT=4009
INVOICE_SERVICE_PORT=4010
PAYMENT_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=4011
AI_SERVICE_PORT=4012

AUTH_SERVICE_URL=http://localhost:3333
USER_SERVICE_URL=http://localhost:3334
QUOTATION_SERVICE_URL=http://localhost:4009
INVOICE_SERVICE_URL=http://localhost:4010
PAYMENT_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:4011
AI_SERVICE_URL=http://localhost:4012