generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Migration 1: Auth Models ─────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Permission {
  id       String           @id @default(uuid())
  action   String
  resource String
  roles    RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Role {
  id          String   @id @default(uuid())
  roleName    String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model User {
  // make optional — not all users login via Google
  id        String     @id @default(uuid())
  fullName  String
  email     String     @unique
  password  String? // make optional — Google users have no password
  roleId    String? // make optional — Google users may not have role yet
  // add avatar field
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  role              Role?          @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  assignedLeads     Lead[]         @relation("AssignedLeads")
  managedProjects   Project[]      @relation("ProjectManager")
  assignedTasks     Task[]         @relation("AssignedTasks")
  recordedExpenses  Expense[]      @relation("RecordedBy")
  uploadedDocuments Document[]     @relation("UploadedDocuments")
  authoredLeadNotes LeadNote[]     @relation("LeadNoteAuthor")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValues String?
  newValues String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

// ─── Migration 2: CRM & Finance Models ───────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
}

model Lead {
  id           String     @id @default(uuid())
  customerName String
  phone        String?
  email        String?
  assignedToId String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedTo User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  customer   Customer?
  quotations Quotation[]
  notes      LeadNote[]
  contacts   LeadContact[]
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  content   String
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation("LeadNoteAuthor", fields: [authorId], references: [id])

  @@index([leadId])
  @@index([authorId])
  @@map("lead_notes")
}

model LeadContact {
  id        String   @id @default(uuid())
  leadId    String
  label     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_contacts")
}

model Customer {
  id        String   @id @default(uuid())
  leadId    String?  @unique
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Migration 3 back-relations
  invoices Invoice[]
  payments Payment[]
}

model Quotation {
  id            String          @id @default(uuid())
  leadId        String
  quotationDate DateTime        @default(now())
  status        QuotationStatus @default(PENDING_APPROVAL)
  totalAmount   Decimal         @db.Decimal(12, 2)
  pdfUrl        String?
  notes         String?
  projectId     String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lead    Lead            @relation(fields: [leadId], references: [id])
  project Project?        @relation(fields: [projectId], references: [id])
  items   QuotationItem[]

  @@map("quotation")
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  itemName    String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_item")
}

// ─── Migration 3: Project, Operations, Finance & Documents ───────────────────
// Anchored by Project. All remaining models depend on it directly or indirectly.
// Operations : Project, Milestone, Task, Expense
// Finance    : Invoice, Payment
// Documents  : DocumentCategory, Document
// Analytics  : AnalyticsReport

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum AiKnowledgeSourceType {
  PROJECT
  MILESTONE
  INVOICE
  PAYMENT
  EXPENSE
}

model Project {
  id               String        @id @default(uuid())
  projectName      String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  budget           Float?
  projectManagerId String
  status           ProjectStatus @default(PLANNING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  quotation         Quotation?
  projectManager    User               @relation("ProjectManager", fields: [projectManagerId], references: [id])
  milestones        Milestone[]
  tasks             Task[]
  expenses          Expense[]
  invoices          Invoice[]
  documents         Document[]
  reports           AnalyticsReport[]
  aiKnowledgeChunks AiKnowledgeChunk[]
}

model Milestone {
  id            String          @id @default(uuid())
  projectId     String
  milestoneName String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  milestoneId  String?
  assignedToId String?
  taskName     String
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project    Project    @relation(fields: [projectId], references: [id])
  milestone  Milestone? @relation(fields: [milestoneId], references: [id])
  assignedTo User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
}

model Expense {
  id           String   @id @default(uuid())
  projectId    String
  recordedById String
  amount       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id])
  recordedBy User    @relation("RecordedBy", fields: [recordedById], references: [id])
}

model Invoice {
  id                String        @id @default(uuid())
  projectId         String
  customerId        String
  invoiceNumber     String?       @unique
  invoiceDate       DateTime
  dueDate           DateTime?
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal       @default(0) @db.Decimal(12, 2)
  pdfPath           String?
  pdfUrl            String?
  pdfGeneratedAt    DateTime?
  notes             String?
  status            InvoiceStatus @default(DRAFT)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project  Project   @relation(fields: [projectId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@index([projectId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String?
  customerId      String
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String        @unique
  notes           String?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice  Invoice? @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
}

model DocumentCategory {
  id           String   @id @default(uuid())
  categoryName String   @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
}

model Document {
  id           String   @id @default(uuid())
  projectId    String
  categoryId   String
  fileName     String
  fileUrl      String
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project          @relation(fields: [projectId], references: [id])
  category   DocumentCategory @relation(fields: [categoryId], references: [id])
  uploadedBy User?            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
}

model AnalyticsReport {
  id                   String   @id @default(uuid())
  projectId            String
  totalRevenue         Float
  expenses             Float
  profit               Float
  completionPercentage Float
  reportDate           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model AiKnowledgeChunk {
  id             String                       @id @default(uuid())
  projectId      String
  sourceType     AiKnowledgeSourceType
  sourceId       String?
  chunkText      String
  metadata       Json?
  embeddingModel String?                      @db.VarChar(100)
  embeddingDim   Int?
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceType, sourceId])
  @@index([projectId])
  @@index([sourceType, sourceId])
  @@map("ai_knowledge_chunks")
}
