{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/jest-e2e.setup.ts"],
  "testRegex": "test/.*\\.(e2e-spec|integration\\.spec|db\\.spec)\\.ts$",
  "testPathIgnorePatterns": ["document-cloudinary\\.integration\\.spec\\.ts$"],
  "testTimeout": 30000,
  "maxWorkers": 3,
  "coverageDirectory": "<rootDir>/coverage/e2e",
  "coverageReporters": ["json", "json-summary"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
